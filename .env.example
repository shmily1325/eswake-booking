# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Contact project admin for the ANON_KEY

VITE_SUPABASE_URL=https://jsonwuelmjloovfjwrnj.supabase.co
VITE_SUPABASE_ANON_KEY=<ask project admin>

# LINE LIFF（會員專區 /liff）
VITE_LIFF_ID=

# LIFF Provider 搬移期間的新會員專區 ID；完成切換後併入 VITE_LIFF_ID
VITE_LIFF_MIGRATION_ID=

# LINE LIFF（線上預約 /liff/book · Rich Menu「我要預約」）
# Endpoint URL: https://<your-domain>/liff/book
VITE_LIFF_BOOK_ID=

# Server-only：可使用會員 API 的 LINE Login Channel ID（逗號分隔）
LINE_LIFF_ALLOWED_CHANNEL_IDS=

# Server-only：與 Messaging API 相同 Provider、可直接 push 的 Channel ID（逗號分隔）
LINE_PUSH_LIFF_CHANNEL_IDS=

# Server-only：Messaging API 長效 Channel access token，用於明日提醒人工推播
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF 綁定失敗時開啟的 LINE 官方帳號連結
VITE_LINE_OA_URL=https://line.me/R/ti/p/@eswakeschool

# 公開預約／行前須知子網域（GoDaddy CNAME → Vercel 後設定）
# VITE_BOOK_BASE_URL=https://book.eswakeschool.com
# VITE_GUIDE_BASE_URL=https://guide.eswakeschool.com

# 商城子網域（參考）
# VITE_SHOP_BASE_URL=https://shop.eswakeschool.com